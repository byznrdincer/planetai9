# Copy to .env and fill in. Consumed by planetai_shared.settings (prefix PLANETAI_).
PLANETAI_DATABASE_URL=postgresql+psycopg://planetai:planetai@localhost:5442/planetai
PLANETAI_REDIS_URL=redis://localhost:6379/0

# YouTube Data API v3 — required for the PlanetAI video collector
PLANETAI_YOUTUBE_API_KEY=
PLANETAI_YOUTUBE_CHANNEL_ID=

PLANETAI_AI_ENRICH_ENABLED=false
