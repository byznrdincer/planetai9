# Copy to infra/.env.prod and fill in. Never commit the real file.

# Public site URL (used for CORS, canonical links, sitemap, RSS)
SITE_URL=https://planetai9.com

# Postgres password (choose a strong value)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Optional — enriches PlanetAI9 videos (views, exact dates). Scraping works without it.
YOUTUBE_API_KEY=

# Optional — Google Cloud Translation API v2 key for TR↔EN news translation.
# Unset ⇒ translation is skipped and the site serves each story in its origin language.
# Setup: docs/07-translation.md
GOOGLE_TRANSLATE_API_KEY=

# Secret for the /yonetim moderation panel (marketplace approvals). Pick a long random value.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Per-author keys for the /yazar writer studio. Format: "slug:secret,slug2:secret2".
# Unset ⇒ /yazar is disabled. e.g. ayhan-demirci:pick-a-long-random-string
AUTHOR_KEYS=

# Author slugs (comma list) allowed to moderate the AI Marketplace queue from /yazar.
# e.g. MODERATOR_AUTHORS=ayhan-demirci
MODERATOR_AUTHORS=

# Host port the web container binds to (put a reverse proxy / TLS in front)
WEB_PORT=3000
