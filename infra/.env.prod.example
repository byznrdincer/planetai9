# Copy to infra/.env.prod and fill in. Never commit the real file.

# Public site URL (used for CORS, canonical links, sitemap, RSS)
SITE_URL=https://planetai9.com

# Postgres password (choose a strong value)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Optional — enriches PlanetAI9 videos (views, exact dates). Scraping works without it.
YOUTUBE_API_KEY=

# Host port the web container binds to (put a reverse proxy / TLS in front)
WEB_PORT=3000
